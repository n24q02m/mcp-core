services:
  notion-mcp-test:
    image: ghcr.io/n24q02m/better-notion-mcp:{{ image_tag | default('beta') }}
    ports:
      - "127.0.0.1:{{ host_port }}:8080"
    environment:
      HOST: "0.0.0.0"
      PORT: "8080"
      TRANSPORT_MODE: "http"
      # HTTP is always multi-user (per spec
      # 2026-05-01-stdio-pure-http-multiuser.md §5.2.3) -- PUBLIC_URL +
      # DCR secret are always set; the legacy mode-flavor env was
      # deleted from the architecture in the same spec.
      PUBLIC_URL: "http://127.0.0.1:{{ host_port }}"
      MCP_DCR_SERVER_SECRET: "{{ mcp_dcr_server_secret }}"
      # mcp-core 1.14+ requires CREDENTIAL_SECRET for HTTP multi-user
      # AES-GCM key derivation (per-JWT-sub credential store).
      CREDENTIAL_SECRET: "e2e-test-credential-secret-32bytes-fixed-for-determinism"
      {% if notion_oauth_client_id is defined and notion_oauth_client_id -%}
      NOTION_OAUTH_CLIENT_ID: "{{ notion_oauth_client_id }}"
      NOTION_OAUTH_CLIENT_SECRET: "{{ notion_oauth_client_secret }}"
      {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/health || curl -fsS http://127.0.0.1:8080/.well-known/oauth-authorization-server || exit 1"]
      interval: 5s
      timeout: 3s
      retries: 12
